SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=False
DATABASE_URL=postgresql://<neon_user>:<neon_password>@<neon_host>/<neon_database>?sslmode=require
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-admin-password

# Optional mail settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@hrdforum.org
ADMIN_NOTIFICATION_EMAIL=alerts@hrdforum.org

# Optional Cloudflare R2 media storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hrd-forum-media
R2_PUBLIC_BASE_URL=
